<%- include('partials/header', { title: 'Profile' }) %>

<section class="form-card">
  <h1>Your profile</h1>
  <form method="post" action="/profile" class="stack">
    <label>Name <input type="text" name="name" value="<%= user.name %>" required /></label>
    <label>Email <input type="email" name="email" value="<%= user.email %>" required /></label>
    <label>Phone <input type="tel" name="phone" value="<%= user.phone || '' %>" /></label>
    <label>Shipping address <textarea name="shippingAddress" rows="3"><%= user.shipping_address || '' %></textarea></label>
    <label>Billing address <textarea name="billingAddress" rows="3"><%= user.billing_address || '' %></textarea></label>
    <button type="submit" class="primary">Save profile</button>
  </form>
</section>

<%- include('partials/footer') %>
