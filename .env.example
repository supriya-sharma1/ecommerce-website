DJANGO_SECRET_KEY=replace-with-your-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database: use mysql for XAMPP, sqlite for quick local demo
DB_ENGINE=mysql
MYSQL_DATABASE=ecommerce_db
